<Window x:Class="CompactLoader.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 xmlns:local="clr-namespace:CompactLoader"
 Title="Compact Loader" Icon="/CompactLoader;component/Assets/app.ico" Width="480" SizeToContent="Height" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
 Background="{DynamicResource AppBackground}" FontFamily="{StaticResource UiFont}" FontSize="12" UseLayoutRounding="True"
 WindowStyle="None" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" Closing="WindowClosing">
 <Window.CommandBindings>
  <CommandBinding Command="ApplicationCommands.Find" Executed="FocusSearch"/>
  <CommandBinding Command="ApplicationCommands.Open" Executed="OpenLibrary"/>
  <CommandBinding Command="NavigationCommands.Refresh" Executed="RefreshProcesses"/>
 </Window.CommandBindings>
 <Window.InputBindings>
  <KeyBinding Key="F" Modifiers="Control" Command="ApplicationCommands.Find"/>
  <KeyBinding Key="O" Modifiers="Control" Command="ApplicationCommands.Open"/>
  <KeyBinding Key="F5" Command="NavigationCommands.Refresh"/>
 </Window.InputBindings>
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="4" UseAeroCaptionButtons="False"/>
 </shell:WindowChrome.WindowChrome>
 <Border x:Name="WindowSurface" Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource FrameBorder}" BorderThickness="1" CornerRadius="4">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
   <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Background="{DynamicResource Surface}">
    <Grid>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
      <Image Source="/CompactLoader;component/Assets/app.ico" Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
      <TextBlock Text="compact" FontSize="13" FontWeight="SemiBold"/>
      <TextBlock Text=".exe" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource UiFont}" VerticalAlignment="Center"/>
     </StackPanel>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <TextBlock x:Name="Architecture" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource UiFont}" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <Button x:Name="UpdateButton" Visibility="Collapsed" Style="{StaticResource CaptionButton}" Width="28" Height="32" Click="UpdateClick" AutomationProperties.Name="Install available update and restart" ToolTip="Update and restart" shell:WindowChrome.IsHitTestVisibleInChrome="True">
       <Path Data="M 7 0 L 7 10 M 3 6 L 7 10 L 11 6 M 1 10 L 1 14 L 13 14 L 13 10" Width="13" Height="14" Stretch="Uniform" Stroke="{DynamicResource Accent}" StrokeThickness="1.3"/>
      </Button>
      <Button x:Name="ThemeToggleButton" Style="{StaticResource CaptionButton}" Width="28" Height="32" Click="ToggleThemeClick" AutomationProperties.Name="Toggle light or dark theme" ToolTip="Switch to light theme" shell:WindowChrome.IsHitTestVisibleInChrome="True">
       <Path x:Name="ThemeGlyph" Data="M 12 1 A 7 7 0 1 0 15 12 A 6 6 0 0 1 12 1" Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource CaptionText}" StrokeThickness="1.2"/>
      </Button>
      <ToggleButton x:Name="AccentPickerToggle" Style="{StaticResource ToolbarToggle}" ToolTip="Accent color" AutomationProperties.Name="Choose accent color" shell:WindowChrome.IsHitTestVisibleInChrome="True">
       <Border BorderBrush="{DynamicResource AccentOutline}" BorderThickness="1" CornerRadius="7" Width="14" Height="14" Padding="3"><Border Background="{DynamicResource Accent}" CornerRadius="4"/></Border>
      </ToggleButton>
      <Popup x:Name="AccentPicker" PlacementTarget="{Binding ElementName=AccentPickerToggle}" Placement="Bottom" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade" IsOpen="{Binding IsChecked, ElementName=AccentPickerToggle, Mode=TwoWay}">
       <Border Background="{DynamicResource PopupSurface}" BorderBrush="{DynamicResource PickerBorder}" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,4,0,0" PreviewKeyDown="AccentPickerKeyDown">
        <StackPanel Width="208">
         <TextBlock Text="Accent color" Foreground="{DynamicResource Muted}" FontSize="11" Margin="3,0,0,6"/>
         <Button x:Name="WindowsAccentButton" Tag="Windows" Click="AccentClick" Padding="8,6" Margin="0,0,0,8" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Use Windows accent color" ToolTip="Follow the Windows accent color">
          <Grid Width="184"><Grid.ColumnDefinitions><ColumnDefinition Width="23"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <Border x:Name="WindowsAccentPreview" Width="15" Height="15" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource InputBorder}" HorizontalAlignment="Left"/>
           <TextBlock Grid.Column="1" Text="Windows" FontSize="11" VerticalAlignment="Center"/>
           <TextBlock Grid.Column="2" x:Name="WindowsAccentState" Text="system" FontFamily="{StaticResource UiFont}" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
          </Grid>
         </Button>
         <StackPanel x:Name="AccentColors" Orientation="Horizontal"/>
         <Expander x:Name="CustomColorExpander" Style="{StaticResource OutputExpanderStyle}" Margin="0,8,0,0">
          <Expander.Header><TextBlock Text="Custom color" FontSize="11"/></Expander.Header>
          <local:AccentColorEditor x:Name="CustomAccentEditor" ApplyRequested="CustomAccentApply"/>
         </Expander>

        </StackPanel>
       </Border>
      </Popup>
      <Button Style="{StaticResource CaptionButton}" Height="32" Click="MinimizeClick" AutomationProperties.Name="Minimize" ToolTip="Minimize" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Data="M 0 5 L 10 5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10"/></Button>
      <Button Style="{StaticResource CloseCaptionButton}" Height="32" Click="CloseClick" AutomationProperties.Name="Close" ToolTip="Close" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Data="M 1 1 L 10 10 M 1 10 L 10 1" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="11" Height="11"/></Button>
     </StackPanel>
    </Grid>
   </Border>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="14,12,14,8">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="Target" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/>
      <ToggleButton Grid.Column="1" x:Name="ProcessPickerToggle" Style="{StaticResource ProcessPickerButton}" MinHeight="44" AutomationProperties.Name="Choose target process" ToolTip="Choose a process (Ctrl+F)" PreviewKeyDown="ProcessSelectorKeyDown">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
        <Image x:Name="SelectedIcon" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="SelectedName" Text="Select a process…" FontFamily="{StaticResource UiFont}" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="SelectedDetail" Text="Name / PID / architecture" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource UiFont}" FontSize="10" Margin="0,3,0,0"/></StackPanel>
        <Path Grid.Column="2" Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource AccentMuted}" StrokeThickness="1.2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
       </Grid>
      </ToggleButton>
      <Popup x:Name="ProcessPicker" PlacementTarget="{Binding ElementName=ProcessPickerToggle}" Placement="Bottom" IsOpen="{Binding IsChecked, ElementName=ProcessPickerToggle, Mode=TwoWay}" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade" Opened="ProcessPickerOpened">
       <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource PickerBorder}" BorderThickness="1" CornerRadius="3" Margin="0,4,0,0" Width="{Binding ActualWidth, ElementName=ProcessPickerToggle}" MinWidth="350" Height="340" PreviewKeyDown="ProcessPickerKeyDown">
     <Grid Margin="10">
      <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="70"/><RowDefinition Height="26"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Processes" FontWeight="SemiBold"/><TextBlock x:Name="ProcessCount" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource UiFont}" Margin="8,0,0,0" FontSize="11"/></StackPanel><Button x:Name="RefreshButton" Content="Refresh" HorizontalAlignment="Right" Padding="9,4" Click="RefreshClick" ToolTip="Refresh processes (F5)"/></Grid>
      <Grid Grid.Row="1" Margin="0,8,0,6"><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="24"/></Grid.RowDefinitions>
       <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <CheckBox x:Name="MainWindowsOnly" Content="Main windows only" VerticalAlignment="Center" Checked="WindowFilterChanged" Unchecked="WindowFilterChanged"/>
        <CheckBox x:Name="AutoRefreshProcesses" Grid.Column="1" Content="Auto refresh" VerticalAlignment="Center" Checked="AutoRefreshChanged" Unchecked="AutoRefreshChanged" ToolTip="Refresh every 3 seconds while the process picker is open. Paused while loading."/>
       </Grid>
       <TextBox x:Name="Search" TextChanged="SearchChanged" FontFamily="{StaticResource UiFont}" FontSize="11" Padding="9,5" VerticalContentAlignment="Center" AutomationProperties.Name="Filter by process name or PID"/>
       <TextBlock Text="Filter by name or PID" Foreground="{DynamicResource Subtle}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Grid>
      <Grid Grid.Row="2" Margin="10,0,10,0" VerticalAlignment="Center">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
       <TextBlock Text="NAME" Foreground="{DynamicResource Subtle}" FontFamily="{StaticResource UiFont}" FontSize="10"/>
       <TextBlock Grid.Column="1" Text="PID" Foreground="{DynamicResource Subtle}" FontFamily="{StaticResource UiFont}" FontSize="10" TextAlignment="Right" Margin="0,0,8,0"/>
       <TextBlock Grid.Column="2" Text="ARCH" Foreground="{DynamicResource Subtle}" FontFamily="{StaticResource UiFont}" FontSize="10" TextAlignment="Right"/>
      </Grid>
      <Grid Grid.Row="3">
       <ListBox x:Name="Processes" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="SelectionChanged" PreviewMouseLeftButtonUp="ProcessPicked" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Processes">
        <ListBox.ItemTemplate><DataTemplate>
         <Grid MinHeight="22">
          <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
          <Image Source="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" FontSize="11"/>
          <TextBlock Grid.Column="2" Text="{Binding Id}" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource UiFont}" FontSize="10" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,8,0"/>
          <TextBlock Grid.Column="3" Text="{Binding Architecture}" Foreground="{DynamicResource AccentMuted}" FontFamily="{StaticResource UiFont}" FontSize="10" VerticalAlignment="Center" TextAlignment="Right"/>
         </Grid>
        </DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <TextBlock Text="No matching processes." Foreground="{DynamicResource Muted}" Margin="10,18,0,0" VerticalAlignment="Top"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=Processes}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Grid>
     </Grid>
       </Border>
      </Popup>
     </Grid>
     <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="DLL" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/>
      <Border Grid.Column="1" x:Name="DropArea" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource FieldBorder}" BorderThickness="1" CornerRadius="3" Padding="0" AllowDrop="True" ToolTip="{Binding Text, ElementName=FileDetailLabel}" Drop="FileDrop" DragOver="FileDragOver">
       <Grid>
        <ComboBox x:Name="RecentLibraries" SelectionChanged="RecentLibrarySelected" AutomationProperties.Name="DLL path and recent libraries" ToolTip="Choose a recent DLL, or drop a DLL here" MaxDropDownHeight="240">
         <ComboBox.Template><ControlTemplate TargetType="ComboBox">
          <Grid>
           <ToggleButton x:Name="HistoryToggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
             <Border x:Name="HistorySurface" Background="Transparent" CornerRadius="3" BorderThickness="1" BorderBrush="Transparent" Height="42">
              <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource AccentMuted}" StrokeThickness="1.3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
             </Border>
             <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HistorySurface" Property="BorderBrush" Value="{DynamicResource AccentHover}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="HistorySurface" Property="BorderBrush" Value="{DynamicResource AccentOutline}"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></ToggleButton.Template>
           </ToggleButton>
           <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
            <Border Background="{DynamicResource PopupSurface}" BorderBrush="{DynamicResource PickerBorder}" BorderThickness="1" CornerRadius="3" Padding="4" Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
             <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
            </Border>
           </Popup>
          </Grid>
          <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentOutline}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
         </ControlTemplate></ComboBox.Template>
        </ComboBox>
        <Grid Margin="10,0,30,0" IsHitTestVisible="False"><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Path Data="M 2 1 L 11 1 L 15 5 L 15 19 L 2 19 Z M 10 1 L 10 6 L 15 6 M 5 10 L 12 10 M 5 14 L 10 14" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource AccentInk}" StrokeThickness="1.3" StrokeLineJoin="Round" HorizontalAlignment="Left" VerticalAlignment="Center"/>
         <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="FileNameLabel" Text="Select a DLL…" TextTrimming="CharacterEllipsis" FontSize="12"/>
          <TextBlock x:Name="FileDetailLabel" Text="Open, drop or choose from history" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" FontSize="10" Margin="0,3,0,0"/>
         </StackPanel>
        </Grid>
       </Grid>
      </Border>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
       <Button x:Name="BrowseButton" Content="Open…" Height="44" Click="BrowseClick" Padding="10,6" ToolTip="Choose a native DLL (Ctrl+O)"/>
      </StackPanel>
     </Grid>

     <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="Method" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/>
       <ComboBox Grid.Column="1" x:Name="Method" Style="{StaticResource PickerComboBox}" SelectedIndex="0" SelectionChanged="MethodChanged" FontFamily="{StaticResource UiFont}" FontSize="11" AutomationProperties.Name="Library load method">
        <ComboBoxItem Content="LoadLibraryW" Tag="LoadLibraryW" ContentTemplate="{StaticResource InjectionMethodLabel}" ToolTip="Standard Windows loader. Start here for ordinary native DLLs."/>
        <ComboBoxItem Content="LdrLoadDll" Tag="LdrLoadDll" ContentTemplate="{StaticResource InjectionMethodLabel}" ToolTip="Native Windows loader, called through a small stub."/>
        <ComboBoxItem Content="LdrpLoader" Tag="LdrpLoader" ContentTemplate="{StaticResource InjectionMethodLabel}" ToolTip="Experimental private loader. Only the verified ntdll binary on x64 build 26300 is supported."/>
        <ComboBoxItem Content="Thread Hijacking" Tag="ThreadHijacking" ContentTemplate="{StaticResource InjectionMethodLabel}" ToolTip="Uses an existing target thread. Advanced method; changes the thread context temporarily."/>
        <ComboBoxItem Content="Manual Map" Tag="ManualMap" ContentTemplate="{StaticResource InjectionMethodLabel}" ToolTip="Experimental PE mapping. TLS, delay imports and unloading are unsupported."/>
       </ComboBox>
     </Grid>
     <Grid Margin="0,12,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="ActionHint" Text="Select a process to continue." VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,10,0"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
       <Button x:Name="InspectButton" Width="32" Padding="7" Margin="0,0,6,0" Click="InspectDllClick" AutomationProperties.Name="Inspect DLL" ToolTip="Inspect DLL — read PE metadata without executing the DLL">
        <Path Data="M 10.5 6 A 4.5 4.5 0 1 1 1.5 6 A 4.5 4.5 0 1 1 10.5 6 M 9.3 9.3 L 14 14" Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
       </Button>
       <Button x:Name="LoadButton" Content="Load DLL" MinWidth="112" Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}" BorderBrush="{DynamicResource AccentOutline}" FontWeight="SemiBold" Padding="16,7" Click="LoadClick" IsEnabled="False"/>
      </StackPanel>
     </Grid>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource ConsoleBackground}" BorderBrush="{DynamicResource ConsoleBorder}" BorderThickness="1" CornerRadius="3" Padding="9,6">
       <TextBlock x:Name="LogPreview" Text="No activity yet." Foreground="{DynamicResource ConsoleText}" FontFamily="{StaticResource UiFont}" FontSize="10" Height="15" LineHeight="15" LineStackingStrategy="BlockLineHeight" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ClipToBounds="True" AutomationProperties.Name="Recent output"/>
      </Border>
      <Button x:Name="OpenOutputButton" Grid.Column="1" Style="{StaticResource CaptionButton}" Width="28" Height="29" Margin="6,0,0,0" Click="OpenOutputClick" AutomationProperties.Name="Open output log">
       <Button.ToolTip><StackPanel><TextBlock Text="Open output in a separate window"/><StackPanel Orientation="Horizontal"><TextBlock Text="Entries: "/><TextBlock x:Name="LogCount" Text="0"/></StackPanel></StackPanel></Button.ToolTip>
       <Path Data="M 1 2 L 13 2 M 1 6 L 13 6 M 3 10 L 7 14 L 11 10" Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
      </Button>
     </Grid>
    </StackPanel>
   </ScrollViewer>
   <Border Grid.Row="2" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Background="{DynamicResource Surface}" Padding="12,0">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="Status" Text="Ready" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource UiFont}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
      <TextBlock x:Name="AppVersion" Foreground="{DynamicResource Muted}" FontSize="9" Margin="0,0,10,0" ToolTip="Application version"/>
      <TextBlock Text="© derevenka-tech" Foreground="{DynamicResource Subtle}" FontSize="9"/>
     </StackPanel>
     <TextBlock Grid.Column="2" Text="Ctrl+F · F5 · Ctrl+O" Foreground="{DynamicResource Subtle}" FontFamily="{StaticResource UiFont}" FontSize="9" VerticalAlignment="Center"/>
    </Grid>
   </Border>
  </Grid>
 </Border>
</Window>
