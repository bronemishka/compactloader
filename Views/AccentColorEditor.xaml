<UserControl x:Class="CompactLoader.AccentColorEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel>
  <Grid Margin="0,6,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="ColorPreview" Width="22" Height="26" CornerRadius="3" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"/>
   <TextBox Grid.Column="1" x:Name="HexText" Text="#A0CB87" MaxLength="7" FontFamily="{StaticResource UiFont}" FontSize="11" Padding="7,5" TextChanged="HexChanged" AutomationProperties.Name="Custom accent hex code" ToolTip="#RRGGBB"/>
  </Grid>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="25"/><RowDefinition Height="25"/></Grid.RowDefinitions>
   <TextBlock Text="R" FontFamily="{StaticResource UiFont}" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
   <Slider Grid.Column="1" x:Name="Red" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ChannelChanged" Style="{StaticResource ColorChannelSlider}" AutomationProperties.Name="Red channel"/>
   <TextBlock Grid.Column="2" x:Name="RedValue" FontFamily="{StaticResource UiFont}" FontSize="10" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource Muted}"/>
   <TextBlock Grid.Row="1" Text="G" FontFamily="{StaticResource UiFont}" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
   <Slider Grid.Row="1" Grid.Column="1" x:Name="Green" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ChannelChanged" Style="{StaticResource ColorChannelSlider}" AutomationProperties.Name="Green channel"/>
   <TextBlock Grid.Row="1" Grid.Column="2" x:Name="GreenValue" FontFamily="{StaticResource UiFont}" FontSize="10" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource Muted}"/>
   <TextBlock Grid.Row="2" Text="B" FontFamily="{StaticResource UiFont}" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
   <Slider Grid.Row="2" Grid.Column="1" x:Name="Blue" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ChannelChanged" Style="{StaticResource ColorChannelSlider}" AutomationProperties.Name="Blue channel"/>
   <TextBlock Grid.Row="2" Grid.Column="2" x:Name="BlueValue" FontFamily="{StaticResource UiFont}" FontSize="10" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource Muted}"/>
  </Grid>
  <TextBlock x:Name="ValidationHint" Text="Enter #RRGGBB or adjust RGB." Foreground="{DynamicResource Subtle}" FontSize="10" Margin="0,5,0,8"/>
  <Button x:Name="ApplyButton" Content="Use color" Click="ApplyClick" FontSize="11" Padding="10,5"/>
 </StackPanel>
</UserControl>
